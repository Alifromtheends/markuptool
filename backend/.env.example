# Markup Backend Environment Variables

# App
APP_NAME=Markup
DEBUG=false
FRONTEND_URL=https://alifromtheends.github.io

# Database
# For Render: sqlite+aiosqlite:///data/markup.db (persistent disk at /data)
# For local dev: sqlite+aiosqlite:///./markup.db
DATABASE_URL=sqlite+aiosqlite:///./markup.db

# Stripe (test mode for dev, live mode for production)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# API
API_KEY_HEADER=X-API-Key
